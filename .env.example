# PLACEHOLDERS ONLY. Never commit secrets or use real employee/customer data.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://pcai_runtime:replace-me@localhost:5432/private_company_ai
# Optional privileged connection used only by npm run db:migrate; never expose it to the app process.
MIGRATION_DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/private_company_ai
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_ROOT=./storage
AI_PROVIDER=deterministic
AI_MODEL=deterministic-v1
MAX_UPLOAD_BYTES=10485760
SESSION_TTL_SECONDS=28800
