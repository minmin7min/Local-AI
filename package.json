{
  "name": "private-company-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run tests/postgres-integration.test.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test:setup": "tsx scripts/setup-test-database.ts",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "reminders": "tsx scripts/reminders.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.5.0",
    "file-type": "^22.0.1",
    "mammoth": "^1.12.0",
    "nanoid": "^6.0.0",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "yauzl": "^3.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yazl": "^3.3.1"
  }
}
